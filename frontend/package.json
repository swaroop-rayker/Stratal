    "@radix-ui/react-tooltip": "1.4.1",
    "@rjsf/core": "6.11.1",
    "@rjsf/utils": "6.11.1",
    "@rjsf/validator-ajv8": "6.11.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-virtual": "3.14.26",
    "@xyflow/react": "13.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
